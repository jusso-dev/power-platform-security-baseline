{
  "globs": [
    "**/*.md",
    "!LICENSE-docs",
    "!node_modules/**",
    "!.venv/**",
    "!.git/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": {
      "allowed_elements": ["a", "img", "details", "summary", "br"]
    },
    "MD041": false
  }
}
