{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "PP-Notify-Admin-Team",
    "description": "Notifies the Power Platform administrator team via Teams/webhook when a high-severity Microsoft Sentinel incident fires and logs an audit comment on the incident using System-Assigned Managed Identity.",
    "author": "power-platform-security-baseline",
    "prerequisites": [
      "Assign Microsoft Sentinel Responder role to the Logic App Managed Identity on the Sentinel workspace resource group.",
      "Configure a Microsoft Teams Workflow webhook URL or Power Platform admin notification endpoint."
    ]
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "PP-Notify-Admin-Team",
      "metadata": {
        "description": "Name of the Logic App playbook."
      }
    },
    "AdminNotificationWebhookUrl": {
      "type": "securestring",
      "metadata": {
        "description": "HTTPS webhook URL for the Power Platform admin team notification channel (Teams Workflows or SOC channel)."
      }
    }
  },
  "variables": {
    "SentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('SentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('SentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "AdminNotificationWebhookUrl": {
              "defaultValue": "",
              "type": "SecureString"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Notify_Power_Platform_Admin_Team": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "@parameters('AdminNotificationWebhookUrl')",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "title": "Power Platform Security Incident",
                  "incidentNumber": "@triggerBody()?['object']?['properties']?['incidentNumber']",
                  "incidentTitle": "@triggerBody()?['object']?['properties']?['title']",
                  "severity": "@triggerBody()?['object']?['properties']?['severity']",
                  "status": "@triggerBody()?['object']?['properties']?['status']",
                  "incidentUrl": "@triggerBody()?['object']?['properties']?['incidentUrl']"
                }
              }
            },
            "Add_comment_to_incident": {
              "type": "ApiConnection",
              "runAfter": {
                "Notify_Power_Platform_Admin_Team": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "<p>Playbook <strong>PP-Notify-Admin-Team</strong> notified the Power Platform administrator team channel for incident @{triggerBody()?['object']?['properties']?['incidentNumber']}.</p>"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
                "connectionName": "[variables('SentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "AdminNotificationWebhookUrl": {
            "value": "[parameters('AdminNotificationWebhookUrl')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
