{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Sentinel Scheduled Analytic Rule Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "severity",
    "status",
    "requiredDataConnectors",
    "queryFrequency",
    "queryPeriod",
    "triggerOperator",
    "triggerThreshold",
    "tactics",
    "relevantTechniques",
    "query",
    "entityMappings",
    "version",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "severity": {
      "type": "string",
      "enum": ["High", "Medium", "Low", "Informational"]
    },
    "status": {
      "type": "string",
      "enum": ["Available", "Deprecated", "Preview"]
    },
    "requiredDataConnectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": { "type": "string", "minLength": 2 },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "queryFrequency": {
      "type": "string",
      "pattern": "^[0-9]+[mhd]$"
    },
    "queryPeriod": {
      "type": "string",
      "pattern": "^[0-9]+[mhd]$"
    },
    "triggerOperator": {
      "type": "string",
      "enum": ["gt", "lt", "eq", "ne"]
    },
    "triggerThreshold": {
      "type": "integer",
      "minimum": 0
    },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Reconnaissance",
          "ResourceDevelopment",
          "InitialAccess",
          "Execution",
          "Persistence",
          "PrivilegeEscalation",
          "DefenseEvasion",
          "CredentialAccess",
          "Discovery",
          "LateralMovement",
          "Collection",
          "CommandAndControl",
          "Exfiltration",
          "Impact"
        ]
      }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "query": {
      "type": "string",
      "minLength": 30
    },
    "entityMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entityType", "fieldMappings"],
        "properties": {
          "entityType": { "type": "string" },
          "fieldMappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["identifier", "columnName"],
              "properties": {
                "identifier": { "type": "string" },
                "columnName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "customDetails": {
      "type": "object"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "const": "Scheduled"
    }
  }
}
