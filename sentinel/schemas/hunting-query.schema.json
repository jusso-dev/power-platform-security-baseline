{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Sentinel Hunting Query Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "requiredDataConnectors",
    "tactics",
    "relevantTechniques",
    "query"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "requiredDataConnectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": { "type": "string", "minLength": 2 },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Reconnaissance",
          "ResourceDevelopment",
          "InitialAccess",
          "Execution",
          "Persistence",
          "PrivilegeEscalation",
          "DefenseEvasion",
          "CredentialAccess",
          "Discovery",
          "LateralMovement",
          "Collection",
          "CommandAndControl",
          "Exfiltration",
          "Impact"
        ]
      }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "query": {
      "type": "string",
      "minLength": 30
    },
    "entityMappings": {
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  }
}
